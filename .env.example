APP_NAME=MedTurno
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Em produção: APP_ENV=production, APP_DEBUG=false e APP_URL com o domínio https real
# (o APP_URL é usado pra montar os links de convite enviados no WhatsApp/e-mail).
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Produção (MySQL 8): troque DB_CONNECTION=mysql e preencha abaixo.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=medturno
# DB_USERNAME=medturno
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção (HTTPS): defina SESSION_SECURE_COOKIE=true pra o cookie só trafegar em https.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# E-MAIL
# Dev: 'log' (os e-mails caem em storage/logs/laravel.log, nada é enviado).
# Produção: use um provedor via SMTP. Exemplos prontos abaixo — basta trocar
# MAIL_MAILER=smtp e preencher usuário/senha (a API key do provedor).
#
#   Resend (https://resend.com):
#     MAIL_MAILER=smtp
#     MAIL_HOST=smtp.resend.com
#     MAIL_PORT=587
#     MAIL_USERNAME=resend
#     MAIL_PASSWORD=re_xxxxxxxx   (sua API key)
#     MAIL_SCHEME=tls
#
#   Brevo / Sendinblue (https://brevo.com):
#     MAIL_MAILER=smtp
#     MAIL_HOST=smtp-relay.brevo.com
#     MAIL_PORT=587
#     MAIL_USERNAME=<seu-login-smtp-brevo>
#     MAIL_PASSWORD=<sua-smtp-key-brevo>
#     MAIL_SCHEME=tls
#
# MAIL_FROM_ADDRESS precisa ser de um domínio verificado no provedor,
# senão a entrega vai pra spam ou falha.
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@medturno.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
